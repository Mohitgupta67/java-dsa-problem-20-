   class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
   }
   public void addLast(int data) {
    Node newNode = new Node( data);
    if(head == null) {
        head = newNode;
        return;
    }
    Node curr = head;
    while(curr.next != null) {
        curr = curr.next;
    }
    curr.next = new node;
   }
   public Node findMiddle(Node head) {
    Node slow = head;
    Node fast = head;

    while(fast != null && fast.next != null) {
        slow = slow.next;
        fast = fast.next.next;
    }
    return slow;
   }
   public void display() {
    Node curr = head;

    while(curr != null) {
        System.out.print(curr.data + "->");
        curr = curr.next;
    }
    System.out.println("null");
   }
